---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
const thanksUrl = new URL('/thanks', Astro.site).href;
---

<Base
  title="Book an IELTS Trial Lesson"
  description="Book a one-to-one IELTS trial lesson with Moona, or send a question first. Find out exactly what's keeping your score at Band 6."
>
  <section class="section book">
    <div class="wrap">
      <div class="narrow">
        <p class="eyebrow">Book a trial lesson</p>
        <h1>Find out exactly what's holding your score back.</h1>
        <p class="lede">
          In the trial we go through your last result, hear you speak and look at your writing. You'll leave knowing
          which criteria are costing you marks and what it will take to reach your target.
        </p>
      </div>

      <div class="options">
        <div class="option option--primary">
          <h2>Pick a time</h2>
          <p>See my availability in your own time zone and book straight away.</p>
          <a class="btn btn--primary" href={site.calLink} target="_blank" rel="noopener">Choose a time on Cal.com</a>
        </div>

        <div class="option" id="ask">
          <h2>Ask a question first</h2>
          <p>Not sure yet? Tell me where you are and I'll reply by email, usually within a day.</p>

          <form action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value={site.web3formsKey} />
            <input type="hidden" name="subject" value="New MyFluency enquiry" />
            <input type="hidden" name="from_name" value="MyFluency website" />
            <input type="hidden" name="redirect" value={thanksUrl} />
            <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

            <label>
              <span>Name</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label>
              <span>Email</span>
              <input type="email" name="email" required autocomplete="email" />
            </label>
            <div class="row">
              <label>
                <span>Last overall band <em>(if any)</em></span>
                <input type="text" name="last_band" inputmode="decimal" placeholder="e.g. 6.0" />
              </label>
              <label>
                <span>Target band</span>
                <input type="text" name="target_band" inputmode="decimal" placeholder="e.g. 7.0" />
              </label>
            </div>
            <div class="row">
              <label>
                <span>Test type</span>
                <select name="test_type">
                  <option>Academic</option>
                  <option>General Training</option>
                  <option>Not sure yet</option>
                </select>
              </label>
              <label>
                <span>Test date <em>(if booked)</em></span>
                <input type="date" name="test_date" />
              </label>
            </div>
            <label>
              <span>What do you need help with?</span>
              <textarea name="message" rows="5" required placeholder="e.g. I keep getting 6 in Writing and need 7 for my visa."
              ></textarea>
            </label>
            <button class="btn btn--primary" type="submit">Send</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .book h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
  }
  .options {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 24px;
    margin-top: 48px;
    align-items: start;
  }
  .option {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(24px, 4vw, 36px);
  }
  .option--primary {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  .option h2 {
    font-size: 1.75rem;
  }
  .option p {
    color: var(--ink-soft);
  }
  form {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }
  label {
    display: grid;
    gap: 6px;
  }
  label span {
    font-weight: 600;
    font-size: 0.95rem;
  }
  label em {
    font-style: normal;
    font-weight: 400;
    color: var(--ink-faint);
  }
  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 12px 14px;
    border: 1px solid #c9bfb2;
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--accent-deep);
    outline-offset: 1px;
    border-color: transparent;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .hp {
    display: none;
  }
  button {
    justify-self: start;
  }
  @media (max-width: 860px) {
    .options {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .row {
      grid-template-columns: 1fr;
    }
    button {
      justify-self: stretch;
    }
  }
</style>
