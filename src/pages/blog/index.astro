---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="IELTS Speaking and Writing Blog"
  description="Practical IELTS advice for candidates stuck at Band 6: Speaking, Writing Task 2 and the techniques that move your score."
>
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Blog</p>
      <h1>Getting past Band 6</h1>
      <p class="lede">Practical IELTS technique for Speaking and Writing. No fluff, no "100 advanced words" lists.</p>

      <ul class="posts">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`}>
                <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    border-top: 1px solid var(--line);
  }
  .posts li {
    border-bottom: 1px solid var(--line);
  }
  .posts a {
    display: block;
    padding: 28px 0;
    text-decoration: none;
    color: var(--ink);
  }
  .posts a:hover h2 {
    color: var(--accent-deep);
  }
  time {
    font-size: 0.88rem;
    color: var(--ink-faint);
  }
  .posts h2 {
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    margin: 6px 0 8px;
    transition: color 0.15s;
  }
  .posts p {
    color: var(--ink-soft);
    margin: 0;
  }
</style>
