---
import Base from '../layouts/Base.astro';
---

<Base title="Message sent" noindex>
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">Message sent</p>
      <h1>Thanks. I'll reply by email soon.</h1>
      <p class="lede">
        Usually within a day. If you'd rather not wait, you can book your trial lesson now.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/book">Book a trial lesson</a>
        <a class="btn btn--ghost" href="/blog">Read the blog</a>
      </div>
    </div>
  </section>
</Base>
